FROM condaforge/miniforge3:latest

WORKDIR /app

COPY drugsets/drugsets_env.yml .
COPY drugsets/ .

# Create a fresh package cache and a dedicated environment
ENV CONDA_PKGS_DIRS=/tmp/conda-pkgs

RUN mamba clean --all --yes && \
    mamba env create -f drugsets_env.yml && \
    mamba clean --all --yes && \
    rm -rf /tmp/conda-pkgs

RUN if [ -f setup.py ] || [ -f pyproject.toml ]; then \
        conda run -n drugsets pip install -e . ; \
    fi

CMD ["conda", "run", "--no-capture-output", "-n", "drugsets", "/bin/bash"]